  <string name="set_engine">Aufnahme-Engine</string>
  <string name="set_engine_desc">A packt den Stream über MediaRecorder. B liest rohes PCM von AudioRecord und gibt volle Kontrolle über Layout, Puffer, Effekte und den Codec.</string>
  <string name="set_source">Audioquelle</string>
  <string name="set_source_desc">Wählt den HAL-Eingangspfad und seine Standard-DSP-Kette aus. Interne Audioquellen benötigen API 29 (Wiedergabeerfassung) oder einen privilegierten Build (REMOTE_SUBMIX, Sprachanruf).</string>
  <string name="set_channels">Kanäle</string>
  <string name="set_channels_desc">Mono- oder Stereoaufnahme. Viele Telefone liefern ein auf beide Kanäle dupliziertes Monosignal.</string>
  <string name="set_sample_rate">Abtastrate</string>
  <string name="set_sample_rate_desc">Angeforderte Erfassungsrate. AMR erzwingt 8/16 kHz. Raten, die der HAL nicht nativ ausführen kann, werden vom Framework erneut abgetastet.</string>
  <string name="set_route">Eingabegerät</string>
  <string name="set_route_desc">Bevorzugter physischer Eingang. Bluetooth öffnet den SCO-Link mit AudioManager.startBluetoothSco() vor der Aufnahme; USB-/Typ-C-Headsets werden über setPreferredDevice() ausgewählt.</string>
  <string name="set_direction">Richtungsgesteuerter Tonabnehmer</string>
  <string name="set_direction_desc">MicrophoneDirection-API (API 29+). Ermöglicht es Geräten mit mehreren Mikrofonen, den Strahl auf den Benutzer zu oder von ihm weg zu lenken.</string>
  <string name="set_field">Abmessungen des Aufnahmefeldes</string>
  <string name="set_field_desc">Zoomfaktor von -1 (am breitesten) bis +1 (am schmalsten) für Geräte, die Beamforming unterstützen.</string>
  <string name="set_privacy">Datenschutzsensibel</string>
  <string name="set_privacy_desc">Markiert die Erfassung als datenschutzrelevant (API 30+): Andere Apps und Assistenten können nicht gleichzeitig erfassen.</string>
  <string name="set_codec_b">Ausgabecodec/Container</string>
  <string name="set_codec_b_desc">PCM geht direkt auf die Festplatte. Komprimierte Optionen verwenden die Plattform-MediaCodec-Encoder mit 16-Bit-Eingabe.</string>
  <string name="set_pcm">Beispielformat</string>
  <string name="set_pcm_desc">PCM-Layout bereitgestellt von AudioRecord. 24/32-Bit benötigt API 31, Float benötigt API 23. Wird wörtlich für WAV/RAW verwendet.</string>
  <string name="set_bitrate">Bitrate</string>
  <string name="set_bitrate_desc">Zielbitrate für den MediaCodec-Encoder.</string>
  <string name="set_bitrate_desc_a">Zielbitrate für MediaRecorder (AMR-Codecs verwenden ihre festen Raten).</string>
  <string name="set_bitrate_mode">Bitratenmodus</string>
  <string name="set_bitrate_mode_desc">KEY_BITRATE_MODE für den Encoder. Nicht jeder Codec berücksichtigt jeden Modus.</string>
  <string name="set_flac_level">FLAC-Komprimierungsstufe</string>
  <string name="set_flac_level_desc">0 = am schnellsten / am größten … 8 = am langsamsten / am kleinsten.</string>
  <string name="set_buffer">AudioRecord-Puffer</string>
  <string name="set_buffer_desc">Auf getMinBufferSize() angewendeter Multiplikator. Kleiner = geringere Latenz, größer = sicherer gegen Überläufe.</string>
  <string name="set_format_a">Container</string>
  <string name="set_format_a_desc">MediaRecorder-Ausgabeformat. Durch Ändern wird automatisch ein kompatibler Encoder ausgewählt.</string>
  <string name="set_encoder_a">Audio-Encoder</string>
  <string name="set_encoder_a_desc">Es werden nur Encoder aufgeführt, die für den ausgewählten Container gültig sind.</string>
  <string name="set_raw">Raw-/Pure-Audio-Modus</string>
  <string name="set_raw_desc">Verwendet die UNPROCESSED-Quelle, wenn das Gerät dies unterstützt, und erzwingt die Ausschaltung von NS/AEC/AGC, sodass die Datei das unberührte Mikrofonsignal enthält.</string>
  <string name="set_ns">Geräuschunterdrücker</string>
  <string name="set_ns_desc">Android.media.audiofx.NoiseSuppressor ist an die Aufnahmesitzung angehängt.</string>
  <string name="set_aec">Akustischer Echokompensator</string>
  <string name="set_aec_desc">Android.media.audiofx.AcousticEchoCanceler an die Aufnahmesitzung angehängt.</string>
  <string name="set_agc">Automatische Verstärkungsregelung</string>
  <string name="set_agc_desc">Android.media.audiofx.AutomaticGainControl an die Aufnahmesitzung angehängt.</string>
  <string name="set_fx_engine_a">Effekte mit Engine A</string>
  <string name="set_fx_engine_a_desc">MediaRecorder stellt seine Audiositzung nicht zur Verfügung, daher folgen die Effekte der Voreinstellung der Audioquelle. Verwenden Sie den Raw-Modus oder wechseln Sie zur expliziten Steuerung zu Engine B.</string>
  <string name="set_silence">Überspringen Sie die Stille</string>
  <string name="set_silence_desc">Unterbricht den Ton, während der Pegel unter dem Schwellenwert bleibt. Motor B lässt PCM-Blöcke fallen; Engine A pausiert / setzt MediaRecorder (API 24+) fort.</string>
  <string name="set_silence_db">Schwelle</string>
  <string name="set_silence_db_desc">RMS-Pegel (Engine B) oder Spitzenpegel (Engine A), unterhalb dessen Audio als Stille gilt.</string>
  <string name="set_silence_hold">Halte die Zeit</string>
  <string name="set_silence_hold_desc">Wie lange muss das Signal ruhig bleiben, bevor das Überspringen beginnt. Das Überspringen stoppt sofort bei Ton.</string>
  <string name="set_storage">Standort</string>
  <string name="set_storage_desc">Beide befinden sich auf einem externen Speicher. Der öffentliche Musikordner benötigt Legacy-Speicherzugriff (targetSdk 29 oder Speicherberechtigung); andernfalls wird der App-Ordner verwendet.</string>
  <string name="set_prefix">Präfix des Dateinamens</string>
  <string name="set_prefix_desc">Dateien heißen PREFIX_yyyyMMdd_HHmmss[.params].ext</string>
  <string name="set_folder">Aktueller Ordner</string>
  <string name="set_fft">Spektrum-FFT-Größe</string>
  <string name="set_fft_desc">Größer = feinere Frequenzauflösung, langsamere Reaktion.</string>
  <string name="set_meter_speed">Zähleraktualisierung</string>
  <string name="set_meter_speed_desc">Wie oft schiebt Engine B Frames an das Armaturenbrett?</string>
  <string name="set_keep_screen">Lassen Sie den Bildschirm eingeschaltet</string>
  <string name="set_keep_screen_desc">Während der Aufnahme auf dem Dashboard-Bildschirm.</string>
