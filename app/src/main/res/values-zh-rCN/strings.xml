  <string name="set_engine">录音引擎</string>
  <string name="set_engine_desc">A通过MediaRecorder对流进行打包。 B 从 AudioRecord 读取原始 PCM，并完全控制布局、缓冲区、效果和编解码器。</string>
  <string name="set_source">音源</string>
  <string name="set_source_desc">选择 HAL 输入路径及其默认 DSP 链。内部音频源需要 API 29（回放捕获）或特权构建（REMOTE_SUBMIX、语音通话）。</string>
  <string name="set_channels">渠道</string>
  <string name="set_channels_desc">单声道或立体声捕捉。许多电话都会将单声道信号复制到两个通道。</string>
  <string name="set_sample_rate">采样率</string>
  <string name="set_sample_rate_desc">请求的捕获率。 AMR 强制为 8/16 kHz。 HAL 本身无法执行的速率由框架重新采样。</string>
  <string name="set_route">输入设备</string>
  <string name="set_route_desc">首选物理输入。蓝牙在捕获之前使用 AudioManager.startBluetoothSco() 打开 SCO 链接； USB / Type-C 耳机通过 setPreferredDevice() 选择。</string>
  <string name="set_direction">定向拾音器</string>
  <string name="set_direction_desc">麦克风方向 API（API 29+）。让多麦克风设备将波束转向或远离用户。</string>
  <string name="set_field">拾取区域尺寸</string>
  <string name="set_field_desc">对于支持波束成形的设备，缩放系数从 -1（最宽）到 +1（最窄）。</string>
  <string name="set_privacy">隐私敏感</string>
  <string name="set_privacy_desc">将捕获标记为隐私敏感（API 30+）：其他应用程序和助手无法同时捕获。</string>
  <string name="set_codec_b">输出编解码器/容器</string>
  <string name="set_codec_b_desc">PCM 直接写入磁盘。压缩选项使用具有 16 位输入的平台 MediaCodec 编码器。</string>
  <string name="set_pcm">样本格式</string>
  <string name="set_pcm_desc">由 AudioRecord 提供的 PCM 布局。 24/32 位需要 API 31，浮点数需要 API 23。逐字用于 WAV / RAW。</string>
  <string name="set_bitrate">比特率</string>
  <string name="set_bitrate_desc">MediaCodec 编码器的目标比特率。</string>
  <string name="set_bitrate_desc_a">MediaRecorder 的目标比特率（AMR 编解码器使用其固定速率）。</string>
  <string name="set_bitrate_mode">码率模式</string>
  <string name="set_bitrate_mode_desc">编码器的 KEY_BITRATE_MODE。并非每个编解码器都支持每种模式。</string>
  <string name="set_flac_level">FLAC压缩级别</string>
  <string name="set_flac_level_desc">0 = 最快/最大…8 = 最慢/最小。</string>
  <string name="set_buffer">录音缓冲区</string>
  <string name="set_buffer_desc">应用于 getMinBufferSize() 的乘数。较小 = 较低的延迟，较大 = 更安全地防止溢出。</string>
  <string name="set_format_a">格式</string>
  <string name="set_format_a_desc">MediaRecorder 输出格式。更改它会自动选择兼容的编码器。</string>
  <string name="set_encoder_a">音频编码器</string>
  <string name="set_encoder_a_desc">仅列出对所选容器有效的编码器。</string>
  <string name="set_raw">原始/纯音频模式</string>
  <string name="set_raw_desc">当设备支持 UNPROCESSED 源并强制关闭 NS / AEC / AGC 时，使用 UNPROCESSED 源，因此文件保留未触及的麦克风信号。</string>
  <string name="set_ns">噪音抑制器</string>
  <string name="set_ns_desc">Android.media.audiofx.NoiseSuppressor 附加到捕获会话。</string>
  <string name="set_aec">声学回声消除器</string>
  <string name="set_aec_desc">Android.media.audiofx.AcousticEchoCanceler 附加到捕获会话。</string>
  <string name="set_agc">自动增益控制</string>
  <string name="set_agc_desc">Android.media.audiofx.AutomaticGainControl 附加到捕获会话。</string>
  <string name="set_fx_engine_a">引擎 A 的效果</string>
  <string name="set_fx_engine_a_desc">MediaRecorder 不会公开其音频会话，因此效果遵循音频源预设。使用原始模式或切换到引擎 B 进行显式控制。</string>
  <string name="set_silence">跳过沉默</string>
  <string name="set_silence_desc">当电平保持在阈值以下时丢弃音频。引擎 B 丢弃 PCM 块；引擎 A 暂停/恢复 MediaRecorder (API 24+)。</string>
  <string name="set_silence_db">临界点</string>
  <string name="set_silence_db_desc">RMS 电平（引擎 B）或峰值电平（引擎 A），低于该电平的音频将被视为静音。</string>
  <string name="set_silence_hold">保持时间</string>
  <string name="set_silence_hold_desc">在开始跳跃之前，信号必须保持安静多长时间。跳过声音立即停止。</string>
  <string name="set_storage">地点</string>
  <string name="set_storage_desc">两者都位于外部存储上。公共 Music 文件夹需要旧存储访问权限（targetSdk 29 或存储权限）；否则使用应用程序文件夹。</string>
  <string name="set_prefix">文件名前缀</string>
  <string name="set_prefix_desc">文件名为 PREFIX_yyyyMMdd_HHmmss[.params].ext</string>
  <string name="set_folder">当前文件夹</string>
  <string name="set_fft">频谱 FFT 大小</string>
  <string name="set_fft_desc">越大=频率分辨率越高，响应越慢。</string>
  <string name="set_meter_speed">仪表刷新</string>
  <string name="set_meter_speed_desc">引擎 B 将帧推送到仪表板的频率。</string>
  <string name="set_keep_screen">保持屏幕开启</string>
  <string name="set_keep_screen_desc">录制时，在仪表板屏幕上。</string>
