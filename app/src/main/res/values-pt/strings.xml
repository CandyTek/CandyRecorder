  <string name="set_engine">Motor de gravação</string>
  <string name="set_engine_desc">A empacota o stream por meio do MediaRecorder. B lê PCM bruto do AudioRecord e oferece controle total sobre layout, buffers, efeitos e codec.</string>
  <string name="set_source">Fonte de áudio</string>
  <string name="set_source_desc">Seleciona o caminho de entrada HAL e sua cadeia DSP padrão. Fontes de áudio interno precisam de API 29 (captura de reprodução) ou uma construção privilegiada (REMOTE_SUBMIX, chamada de voz).</string>
  <string name="set_channels">Canais</string>
  <string name="set_channels_desc">Captura mono ou estéreo. Muitos telefones fornecem um sinal mono duplicado em ambos os canais.</string>
  <string name="set_sample_rate">Taxa de amostragem</string>
  <string name="set_sample_rate_desc">Taxa de captura solicitada. AMR força 8/16 kHz. As taxas que o HAL não pode fazer nativamente são reamostradas pela estrutura.</string>
  <string name="set_route">Dispositivo de entrada</string>
  <string name="set_route_desc">Entrada física preferida. O Bluetooth abre o link SCO com AudioManager.startBluetoothSco() antes da captura; Os fones de ouvido USB/Tipo C são selecionados via setPreferredDevice().</string>
  <string name="set_direction">Captação direcional</string>
  <string name="set_direction_desc">API MicrophoneDirection (API 29+). Permite que dispositivos multi-mic direcionem o feixe em direção ou longe do usuário.</string>
  <string name="set_field">Dimensão do campo de retirada</string>
  <string name="set_field_desc">Fator de zoom de -1 (mais amplo) a +1 (mais estreito) para dispositivos que suportam beamforming.</string>
  <string name="set_privacy">Sensível à privacidade</string>
  <string name="set_privacy_desc">Marca a captura como sensível à privacidade (API 30+): outros aplicativos e assistentes não podem capturar simultaneamente.</string>
  <string name="set_codec_b">Codec/contêiner de saída</string>
  <string name="set_codec_b_desc">PCM vai direto para o disco. As opções compactadas usam os codificadores da plataforma MediaCodec com entrada de 16 bits.</string>
  <string name="set_pcm">Formato de amostra</string>
  <string name="set_pcm_desc">Layout PCM entregue pela AudioRecord. 24/32 bits precisa de API 31, float precisa de API 23. Usado literalmente para WAV/RAW.</string>
  <string name="set_bitrate">Taxa de bits</string>
  <string name="set_bitrate_desc">Taxa de bits desejada para o codificador MediaCodec.</string>
  <string name="set_bitrate_desc_a">Taxa de bits desejada para MediaRecorder (codecs AMR usam suas taxas fixas).</string>
  <string name="set_bitrate_mode">Modo taxa de bits</string>
  <string name="set_bitrate_mode_desc">KEY_BITRATE_MODE para o codificador. Nem todo codec respeita todos os modos.</string>
  <string name="set_flac_level">Nível de compressão FLAC</string>
  <string name="set_flac_level_desc">0 = mais rápido/maior… 8 = mais lento/menor.</string>
  <string name="set_buffer">Buffer de gravação de áudio</string>
  <string name="set_buffer_desc">Multiplicador aplicado a getMinBufferSize(). Menor = menor latência, maior = mais seguro contra sobrecargas.</string>
  <string name="set_format_a">Recipiente</string>
  <string name="set_format_a_desc">Formato de saída do MediaRecorder. Alterá-lo seleciona automaticamente um codificador compatível.</string>
  <string name="set_encoder_a">Codificador de áudio</string>
  <string name="set_encoder_a_desc">Somente codificadores válidos para o contêiner escolhido são listados.</string>
  <string name="set_raw">Modo de áudio bruto/puro</string>
  <string name="set_raw_desc">Usa a fonte UNPROCESSED quando o dispositivo a suporta e força o desligamento de NS/AEC/AGC, para que o arquivo mantenha o sinal do microfone intocado.</string>
  <string name="set_ns">Supressor de ruído</string>
  <string name="set_ns_desc">Android.media.audiofx.NoiseSuppressor anexado à sessão de captura.</string>
  <string name="set_aec">Cancelador de eco acústico</string>
  <string name="set_aec_desc">Android.media.audiofx.AcousticEchoCanceler anexado à sessão de captura.</string>
  <string name="set_agc">Controle automático de ganho</string>
  <string name="set_agc_desc">Android.media.audiofx.AutomaticGainControl anexado à sessão de captura.</string>
  <string name="set_fx_engine_a">Efeitos com o Motor A</string>
  <string name="set_fx_engine_a_desc">O MediaRecorder não expõe sua sessão de áudio, portanto os efeitos seguem a predefinição da fonte de áudio. Use o modo bruto ou mude para o Motor B para controle explícito.</string>
  <string name="set_silence">Pular silêncio</string>
  <string name="set_silence_desc">Reduz o áudio enquanto o nível permanece abaixo do limite. O motor B descarta pedaços de PCM; O mecanismo A pausa/retoma o MediaRecorder (API 24+).</string>
  <string name="set_silence_db">Limite</string>
  <string name="set_silence_db_desc">Nível RMS (Motor B) ou nível de pico (Motor A) abaixo do qual o áudio conta como silêncio.</string>
  <string name="set_silence_hold">Tempo de espera</string>
  <string name="set_silence_hold_desc">Quanto tempo o sinal deve permanecer silencioso antes de iniciar o salto. O salto para instantaneamente com o som.</string>
  <string name="set_storage">Localização</string>
  <string name="set_storage_desc">Ambos estão em armazenamento externo. A pasta pública Music precisa de acesso de armazenamento herdado (targetSdk 29 ou permissão de armazenamento); caso contrário, a pasta do aplicativo será usada.</string>
  <string name="set_prefix">Prefixo do nome do arquivo</string>
  <string name="set_prefix_desc">Os arquivos são nomeados PREFIX_yyyyMMdd_HHmmss[.params].ext</string>
  <string name="set_folder">Pasta atual</string>
  <string name="set_fft">Tamanho do espectro FFT</string>
  <string name="set_fft_desc">Maior = resolução de frequência mais precisa, resposta mais lenta.</string>
  <string name="set_meter_speed">Atualização do medidor</string>
  <string name="set_meter_speed_desc">Com que frequência o Engine B envia frames para o painel.</string>
  <string name="set_keep_screen">Manter a tela ligada</string>
  <string name="set_keep_screen_desc">Durante a gravação, na tela do painel.</string>
