  <string name="set_engine">محرك التسجيل</string>
  <string name="set_engine_desc">يحزم الدفق من خلال MediaRecorder. يقرأ B PCM الخام من AudioRecord ويمنح تحكمًا كاملاً في التخطيط والمخازن المؤقتة والتأثيرات وبرامج الترميز.</string>
  <string name="set_source">مصدر الصوت</string>
  <string name="set_source_desc">يحدد مسار إدخال HAL وسلسلة DSP الافتراضية الخاصة به. تحتاج مصادر الصوت الداخلي إلى API 29 (التقاط التشغيل) أو إصدار مميز (REMOTE_SUBMIX، مكالمة صوتية).</string>
  <string name="set_channels">القنوات</string>
  <string name="set_channels_desc">التقاط أحادي أو استريو. تقدم العديد من الهواتف إشارة أحادية مكررة لكلا القناتين.</string>
  <string name="set_sample_rate">معدل العينة</string>
  <string name="set_sample_rate_desc">معدل الالتقاط المطلوب AMR قوات 8/16 كيلو هرتز. يتم إعادة تشكيل الأسعار التي لا يستطيع HAL القيام بها محليًا بواسطة إطار العمل.</string>
  <string name="set_route">جهاز الإدخال</string>
  <string name="set_route_desc">المدخلات المادية المفضلة. يفتح Bluetooth رابط SCO مع AudioManager.startBluetoothSco() قبل الالتقاط؛ يتم تحديد سماعات الرأس USB / Type-C عبر setPreferredDevice().</string>
  <string name="set_direction">لاقط الاتجاه</string>
  <string name="set_direction_desc">واجهة برمجة تطبيقات اتجاه الميكروفون (API 29+). يتيح للأجهزة متعددة الميكروفون توجيه الشعاع نحو المستخدم أو بعيدًا عنه.</string>
  <string name="set_field">البعد الميداني للالتقاط</string>
  <string name="set_field_desc">عامل التكبير من -1 (الأوسع) إلى +1 (الأضيق) للأجهزة التي تدعم تكوين الشعاع.</string>
  <string name="set_privacy">الخصوصية حساسة</string>
  <string name="set_privacy_desc">يضع علامة على الالتقاط على أنه حساس للخصوصية (API 30+): لا يمكن للتطبيقات والمساعدين الآخرين التقاطها بشكل متزامن.</string>
  <string name="set_codec_b">ترميز الإخراج / الحاوية</string>
  <string name="set_codec_b_desc">يذهب PCM مباشرة إلى القرص. تستخدم الخيارات المضغوطة برامج ترميز MediaCodec للنظام الأساسي مع إدخال 16 بت.</string>
  <string name="set_pcm">تنسيق العينة</string>
  <string name="set_pcm_desc">يتم تسليم تخطيط PCM بواسطة AudioRecord. يحتاج 24/32 بت إلى API 31، ويحتاج التعويم إلى API 23. يُستخدم حرفيًا لـ WAV / RAW.</string>
  <string name="set_bitrate">معدل البت</string>
  <string name="set_bitrate_desc">معدل البت المستهدف لبرنامج تشفير MediaCodec.</string>
  <string name="set_bitrate_desc_a">معدل البت المستهدف لـ MediaRecorder (تستخدم برامج ترميز AMR معدلاتها الثابتة).</string>
  <string name="set_bitrate_mode">وضع معدل البت</string>
  <string name="set_bitrate_mode_desc">KEY_BITRATE_MODE لجهاز التشفير. ليس كل برنامج ترميز يحترم كل وضع.</string>
  <string name="set_flac_level">مستوى ضغط FLAC</string>
  <string name="set_flac_level_desc">0 = الأسرع / الأكبر … 8 = الأبطأ / الأصغر.</string>
  <string name="set_buffer">المخزن المؤقت لتسجيل الصوت</string>
  <string name="set_buffer_desc">تم تطبيق المضاعف على getMinBufferSize(). أصغر = زمن وصول أقل، أكبر = أكثر أمانًا ضد التجاوزات.</string>
  <string name="set_format_a">حاوية</string>
  <string name="set_format_a_desc">تنسيق إخراج MediaRecorder. يؤدي تغييره تلقائيًا إلى تحديد برنامج تشفير متوافق.</string>
  <string name="set_encoder_a">التشفير الصوتي</string>
  <string name="set_encoder_a_desc">تم إدراج برامج التشفير الصالحة للحاوية المختارة فقط.</string>
  <string name="set_raw">وضع الصوت الخام / النقي</string>
  <string name="set_raw_desc">يستخدم المصدر غير المعالج عندما يدعمه الجهاز ويفرض إيقاف تشغيل NS / AEC / AGC، بحيث يحتفظ الملف بإشارة الميكروفون التي لم يتم لمسها.</string>
  <string name="set_ns">كاتم الضوضاء</string>
  <string name="set_ns_desc">Android.media.audiofx.NoiseSuppressor مرفق بجلسة الالتقاط.</string>
  <string name="set_aec">مانع الصدى الصوتي</string>
  <string name="set_aec_desc">Android.media.audiofx.AcousticEchoCanceler مرفق بجلسة الالتقاط.</string>
  <string name="set_agc">التحكم التلقائي في الكسب</string>
  <string name="set_agc_desc">Android.media.audiofx.AutomaticGainControl المرفقة بجلسة الالتقاط.</string>
  <string name="set_fx_engine_a">التأثيرات مع المحرك أ</string>
  <string name="set_fx_engine_a_desc">لا يعرض MediaRecorder جلسة الصوت الخاصة به، لذا تتبع التأثيرات الإعداد المسبق لمصدر الصوت. استخدم الوضع الخام أو قم بالتبديل إلى المحرك B للتحكم الواضح.</string>
  <string name="set_silence">تخطي الصمت</string>
  <string name="set_silence_desc">يسقط الصوت بينما يبقى المستوى تحت العتبة. المحرك B يسقط قطع PCM؛ المحرك A يوقف مؤقتًا/يستأنف MediaRecorder (API 24+).</string>
  <string name="set_silence_db">عتبة</string>
  <string name="set_silence_db_desc">مستوى RMS (المحرك B) أو مستوى الذروة (المحرك A) الذي يتم اعتبار الصوت أدناه كصمت.</string>
  <string name="set_silence_hold">عقد الوقت</string>
  <string name="set_silence_hold_desc">المدة التي يجب أن تظل فيها الإشارة هادئة قبل أن يبدأ التخطي. يتوقف التخطي فورًا عند ظهور الصوت.</string>
  <string name="set_storage">موقع</string>
  <string name="set_storage_desc">كلاهما على وحدة التخزين الخارجية. يحتاج مجلد الموسيقى العام إلى الوصول إلى التخزين القديم (targetSdk 29 أو إذن التخزين)؛ وإلا فسيتم استخدام مجلد التطبيق.</string>
  <string name="set_prefix">بادئة اسم الملف</string>
  <string name="set_prefix_desc">تتم تسمية الملفات بـ PREFIX_yyyyMMdd_HHmmss[.params].ext</string>
  <string name="set_folder">المجلد الحالي</string>
  <string name="set_fft">حجم الطيف FFT</string>
  <string name="set_fft_desc">أكبر = دقة تردد أدق، واستجابة أبطأ.</string>
  <string name="set_meter_speed">تحديث العداد</string>
  <string name="set_meter_speed_desc">كم مرة يدفع المحرك B الإطارات إلى لوحة القيادة.</string>
  <string name="set_keep_screen">إبقاء الشاشة قيد التشغيل</string>
