	<!-- Settings rows -->
	<string name="set_engine">Recording engine</string>
	<string name="set_engine_desc">A packs the stream through MediaRecorder. B reads raw PCM from AudioRecord and gives full control over layout, buffers, effects and the codec.</string>
	<string name="set_source">Audio source</string>
	<string name="set_source_desc">Selects the HAL input path and its default DSP chain. Internal-audio sources need API 29 (playback capture) or a privileged build (REMOTE_SUBMIX, voice call).</string>
	<string name="set_channels">Channels</string>
	<string name="set_channels_desc">Mono or stereo capture. Many phones deliver a mono signal duplicated to both channels.</string>
	<string name="set_sample_rate">Sample rate</string>
	<string name="set_sample_rate_desc">Requested capture rate. AMR forces 8/16 kHz. Rates the HAL cannot do natively are resampled by the framework.</string>
	<string name="set_route">Input device</string>
	<string name="set_route_desc">Preferred physical input. Bluetooth opens the SCO link with AudioManager.startBluetoothSco() before capture; USB / Type-C headsets are selected via setPreferredDevice().</string>
	<string name="set_direction">Directional pickup</string>
	<string name="set_direction_desc">MicrophoneDirection API (API 29+). Lets multi-mic devices steer the beam towards or away from the user.</string>
	<string name="set_field">Pickup field dimension</string>
	<string name="set_field_desc">Zoom factor from -1 (widest) to +1 (narrowest) for devices that support beamforming.</string>
	<string name="set_privacy">Privacy sensitive</string>
	<string name="set_privacy_desc">Marks the capture as privacy sensitive (API 30+): other apps and assistants cannot concurrently capture.</string>
	<string name="set_codec_b">Output codec / container</string>
	<string name="set_codec_b_desc">PCM goes straight to disk. Compressed options use the platform MediaCodec encoders with 16-bit input.</string>
	<string name="set_pcm">Sample format</string>
	<string name="set_pcm_desc">PCM layout delivered by AudioRecord. 24/32-bit need API 31, float needs API 23. Used verbatim for WAV / RAW.</string>
	<string name="set_bitrate">Bitrate</string>
	<string name="set_bitrate_desc">Target bitrate for the MediaCodec encoder.</string>
	<string name="set_bitrate_desc_a">Target bitrate for MediaRecorder (AMR codecs use their fixed rates).</string>
	<string name="set_bitrate_mode">Bitrate mode</string>
	<string name="set_bitrate_mode_desc">KEY_BITRATE_MODE for the encoder. Not every codec honours every mode.</string>
	<string name="set_flac_level">FLAC compression level</string>
	<string name="set_flac_level_desc">0 = fastest / largest … 8 = slowest / smallest.</string>
	<string name="set_buffer">AudioRecord buffer</string>
	<string name="set_buffer_desc">Multiplier applied to getMinBufferSize(). Smaller = lower latency, larger = safer against overruns.</string>
	<string name="set_format_a">Container</string>
	<string name="set_format_a_desc">MediaRecorder output format. Changing it auto-selects a compatible encoder.</string>
	<string name="set_encoder_a">Audio encoder</string>
	<string name="set_encoder_a_desc">Only encoders valid for the chosen container are listed.</string>
	<string name="set_raw">Raw / pure audio mode</string>
	<string name="set_raw_desc">Uses the UNPROCESSED source when the device supports it and forces NS / AEC / AGC off, so the file holds the untouched microphone signal.</string>
	<string name="set_ns">Noise suppressor</string>
	<string name="set_ns_desc">android.media.audiofx.NoiseSuppressor attached to the capture session.</string>
	<string name="set_aec">Acoustic echo canceler</string>
	<string name="set_aec_desc">android.media.audiofx.AcousticEchoCanceler attached to the capture session.</string>
	<string name="set_agc">Automatic gain control</string>
	<string name="set_agc_desc">android.media.audiofx.AutomaticGainControl attached to the capture session.</string>
	<string name="set_fx_engine_a">Effects with Engine A</string>
	<string name="set_fx_engine_a_desc">MediaRecorder does not expose its audio session, so effects follow the audio source preset. Use raw mode or switch to Engine B for explicit control.</string>
	<string name="set_silence">Skip silence</string>
	<string name="set_silence_desc">Drops audio while the level stays under the threshold. Engine B drops PCM chunks; Engine A pauses / resumes MediaRecorder (API 24+).</string>
	<string name="set_silence_db">Threshold</string>
	<string name="set_silence_db_desc">RMS level (Engine B) or peak level (Engine A) below which audio counts as silence.</string>
	<string name="set_silence_hold">Hold time</string>
	<string name="set_silence_hold_desc">How long the signal must stay quiet before skipping starts. Skipping stops instantly on sound.</string>
	<string name="set_storage">Location</string>
	<string name="set_storage_desc">Both are on external storage. The public Music folder needs legacy storage access (targetSdk 29 or storage permission); otherwise the app folder is used.</string>
	<string name="set_prefix">File name prefix</string>
	<string name="set_prefix_desc">Files are named PREFIX_yyyyMMdd_HHmmss[.params].ext</string>
	<string name="set_folder">Current folder</string>
	<string name="set_fft">Spectrum FFT size</string>
	<string name="set_fft_desc">Larger = finer frequency resolution, slower response.</string>
	<string name="set_meter_speed">Meter refresh</string>
	<string name="set_meter_speed_desc">How often Engine B pushes frames to the dashboard.</string>
	<string name="set_keep_screen">Keep screen on</string>
	<string name="set_keep_screen_desc">While recording, on the dashboard screen.</string>
