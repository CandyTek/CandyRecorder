  <string name="set_engine">Motor de grabación</string>
  <string name="set_engine_desc">A empaqueta la transmisión a través de MediaRecorder. B lee PCM sin procesar de AudioRecord y brinda control total sobre el diseño, los buffers, los efectos y el códec.</string>
  <string name="set_source">Fuente de audio</string>
  <string name="set_source_desc">Selecciona la ruta de entrada HAL y su cadena DSP predeterminada. Las fuentes de audio interno necesitan API 29 (captura de reproducción) o una compilación privilegiada (REMOTE_SUBMIX, llamada de voz).</string>
  <string name="set_channels">Canales</string>
  <string name="set_channels_desc">Captura mono o estéreo. Muchos teléfonos entregan una señal mono duplicada en ambos canales.</string>
  <string name="set_sample_rate">Frecuencia de muestreo</string>
  <string name="set_sample_rate_desc">Tasa de captura solicitada. AMR fuerza 8/16 kHz. El marco vuelve a muestrear las velocidades que HAL no puede realizar de forma nativa.</string>
  <string name="set_route">Dispositivo de entrada</string>
  <string name="set_route_desc">Entrada física preferida. Bluetooth abre el enlace SCO con AudioManager.startBluetoothSco() antes de la captura; Los auriculares USB/Tipo C se seleccionan mediante setPreferredDevice().</string>
  <string name="set_direction">Recogida direccional</string>
  <string name="set_direction_desc">API de dirección de micrófono (API 29+). Permite que los dispositivos con varios micrófonos dirijan el haz hacia o lejos del usuario.</string>
  <string name="set_field">Dimensión del campo de recogida</string>
  <string name="set_field_desc">Factor de zoom de -1 (más ancho) a +1 (más estrecho) para dispositivos que admiten formación de haces.</string>
  <string name="set_privacy">Sensible a la privacidad</string>
  <string name="set_privacy_desc">Marca la captura como sensible a la privacidad (API 30+): otras aplicaciones y asistentes no pueden realizar capturas simultáneamente.</string>
  <string name="set_codec_b">Códec/contenedor de salida</string>
  <string name="set_codec_b_desc">PCM va directamente al disco. Las opciones comprimidas utilizan los codificadores MediaCodec de plataforma con entrada de 16 bits.</string>
  <string name="set_pcm">Formato de muestra</string>
  <string name="set_pcm_desc">Diseño PCM entregado por AudioRecord. 24/32 bits necesitan API 31, float necesita API 23. Se usa palabra por palabra para WAV/RAW.</string>
  <string name="set_bitrate">Tasa de bits</string>
  <string name="set_bitrate_desc">Tasa de bits objetivo para el codificador MediaCodec.</string>
  <string name="set_bitrate_desc_a">Tasa de bits objetivo para MediaRecorder (los códecs AMR utilizan sus tasas fijas).</string>
  <string name="set_bitrate_mode">Modo de tasa de bits</string>
  <string name="set_bitrate_mode_desc">KEY_BITRATE_MODE para el codificador. No todos los códecs respetan todos los modos.</string>
  <string name="set_flac_level">Nivel de compresión FLAC</string>
  <string name="set_flac_level_desc">0 = más rápido/más grande… 8 = más lento/más pequeño.</string>
  <string name="set_buffer">Búfer de grabación de audio</string>
  <string name="set_buffer_desc">Multiplicador aplicado a getMinBufferSize(). Más pequeño = menor latencia, más grande = más seguro contra desbordamientos.</string>
  <string name="set_format_a">Recipiente</string>
  <string name="set_format_a_desc">Formato de salida de MediaRecorder. Al cambiarlo, se selecciona automáticamente un codificador compatible.</string>
  <string name="set_encoder_a">Codificador de audio</string>
  <string name="set_encoder_a_desc">Solo se enumeran los codificadores válidos para el contenedor elegido.</string>
  <string name="set_raw">Modo de audio puro/sin formato</string>
  <string name="set_raw_desc">Utiliza la fuente SIN PROCESAR cuando el dispositivo la admite y fuerza a NS/AEC/AGC a desactivarse, por lo que el archivo retiene la señal del micrófono intacta.</string>
  <string name="set_ns">Supresor de ruido</string>
  <string name="set_ns_desc">Android.media.audiofx.NoiseSuppressor adjunto a la sesión de captura.</string>
  <string name="set_aec">Cancelador de eco acústico</string>
  <string name="set_aec_desc">Android.media.audiofx.AcousticEchoCanceler adjunto a la sesión de captura.</string>
  <string name="set_agc">Control automático de ganancia</string>
  <string name="set_agc_desc">Android.media.audiofx.AutomaticGainControl adjunto a la sesión de captura.</string>
  <string name="set_fx_engine_a">Efectos con el motor A</string>
  <string name="set_fx_engine_a_desc">MediaRecorder no expone su sesión de audio, por lo que los efectos siguen la fuente de audio preestablecida. Utilice el modo sin formato o cambie al motor B para un control explícito.</string>
  <string name="set_silence">Saltar el silencio</string>
  <string name="set_silence_desc">Baja el audio mientras el nivel permanece por debajo del umbral. El motor B deja caer trozos de PCM; El motor A pausa/reanuda MediaRecorder (API 24+).</string>
  <string name="set_silence_db">Límite</string>
  <string name="set_silence_db_desc">Nivel RMS (motor B) o nivel máximo (motor A) por debajo del cual el audio cuenta como silencio.</string>
  <string name="set_silence_hold">Tiempo de espera</string>
  <string name="set_silence_hold_desc">Cuánto tiempo debe permanecer silenciosa la señal antes de que comience el salto. El salto se detiene instantáneamente con el sonido.</string>
  <string name="set_storage">Ubicación</string>
  <string name="set_storage_desc">Ambos están en almacenamiento externo. La carpeta pública de Música necesita acceso al almacenamiento heredado (targetSdk 29 o permiso de almacenamiento); de lo contrario, se utiliza la carpeta de la aplicación.</string>
  <string name="set_prefix">Prefijo de nombre de archivo</string>
  <string name="set_prefix_desc">Los archivos se denominan PREFIX_yyyyMMdd_HHmmss[.params].ext</string>
  <string name="set_folder">Carpeta actual</string>
  <string name="set_fft">Tamaño del espectro FFT</string>
  <string name="set_fft_desc">Más grande = resolución de frecuencia más fina, respuesta más lenta.</string>
  <string name="set_meter_speed">Actualización del medidor</string>
  <string name="set_meter_speed_desc">Con qué frecuencia el motor B empuja los marcos hacia el tablero.</string>
  <string name="set_keep_screen">Mantener la pantalla encendida</string>
  <string name="set_keep_screen_desc">Mientras graba, en la pantalla del tablero.</string>
