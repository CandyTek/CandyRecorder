  <string name="set_engine">Motore di registrazione</string>
  <string name="set_engine_desc">A comprime lo streaming tramite MediaRecorder. B legge il PCM grezzo da AudioRecord e offre il pieno controllo su layout, buffer, effetti e codec.</string>
  <string name="set_source">Sorgente audio</string>
  <string name="set_source_desc">Seleziona il percorso di input dell\'HAL e la relativa catena DSP predefinita. Le sorgenti audio interne necessitano dell\'API 29 (acquisizione della riproduzione) o di una build privilegiata (REMOTE_SUBMIX, chiamata vocale).</string>
  <string name="set_channels">Canali</string>
  <string name="set_channels_desc">Acquisizione mono o stereo. Molti telefoni trasmettono un segnale mono duplicato su entrambi i canali.</string>
  <string name="set_sample_rate">Frequenza di campionamento</string>
  <string name="set_sample_rate_desc">Tasso di acquisizione richiesto. L\'AMR forza 8/16 kHz. Le tariffe che l\'HAL non può eseguire in modo nativo vengono ricampionate dal framework.</string>
  <string name="set_route">Dispositivo di input</string>
  <string name="set_route_desc">Ingresso fisico preferito. Bluetooth apre il collegamento SCO con AudioManager.startBluetoothSco() prima dell\'acquisizione; Le cuffie USB/Type-C vengono selezionate tramite setPreferredDevice().</string>
  <string name="set_direction">Pickup direzionale</string>
  <string name="set_direction_desc">API MicrophoneDirection (API 29+). Consente ai dispositivi multi-microfono di indirizzare il raggio verso o lontano dall\'utente.</string>
  <string name="set_field">Dimensione del campo di prelievo</string>
  <string name="set_field_desc">Fattore di zoom da -1 (il più largo) a +1 (il più stretto) per i dispositivi che supportano il beamforming.</string>
  <string name="set_privacy">Sensibile alla privacy</string>
  <string name="set_privacy_desc">Contrassegna l\'acquisizione come sensibile alla privacy (API 30+): altre app e assistenti non possono acquisire contemporaneamente.</string>
  <string name="set_codec_b">Codec/contenitore di output</string>
  <string name="set_codec_b_desc">PCM va direttamente sul disco. Le opzioni compresse utilizzano i codificatori MediaCodec della piattaforma con input a 16 bit.</string>
  <string name="set_pcm">Formato del campione</string>
  <string name="set_pcm_desc">Layout PCM fornito da AudioRecord. 24/32 bit richiede API 31, float richiede API 23. Utilizzato alla lettera per WAV/RAW.</string>
  <string name="set_bitrate">Velocità in bit</string>
  <string name="set_bitrate_desc">Bitrate target per il codificatore MediaCodec.</string>
  <string name="set_bitrate_desc_a">Bitrate target per MediaRecorder (i codec AMR utilizzano le loro velocità fisse).</string>
  <string name="set_bitrate_mode">Modalità velocità in bit</string>
  <string name="set_bitrate_mode_desc">KEY_BITRATE_MODE per il codificatore. Non tutti i codec rispettano tutte le modalità.</string>
  <string name="set_flac_level">Livello di compressione FLAC</string>
  <string name="set_flac_level_desc">0 = più veloce/più grande… 8 = più lento/più piccolo.</string>
  <string name="set_buffer">Buffer di registrazione audio</string>
  <string name="set_buffer_desc">Moltiplicatore applicato a getMinBufferSize(). Più piccolo = latenza inferiore, più grande = più sicuro contro i sovraccarichi.</string>
  <string name="set_format_a">Contenitore</string>
  <string name="set_format_a_desc">Formato di output del registratore multimediale. Modificandolo si seleziona automaticamente un codificatore compatibile.</string>
  <string name="set_encoder_a">Codificatore audio</string>
  <string name="set_encoder_a_desc">Vengono elencati solo i codificatori validi per il contenitore scelto.</string>
  <string name="set_raw">Modalità audio grezza/pura</string>
  <string name="set_raw_desc">Utilizza la sorgente NON PROCESSATA quando il dispositivo la supporta e forza la disattivazione di NS/AEC/AGC, in modo che il file mantenga il segnale del microfono intatto.</string>
  <string name="set_ns">Soppressore di rumore</string>
  <string name="set_ns_desc">Android.media.audiofx.NoiseSuppressor allegato alla sessione di acquisizione.</string>
  <string name="set_aec">Cancellatore di eco acustico</string>
  <string name="set_aec_desc">Android.media.audiofx.AcousticEchoCanceler allegato alla sessione di acquisizione.</string>
  <string name="set_agc">Controllo automatico del guadagno</string>
  <string name="set_agc_desc">Android.media.audiofx.AutomaticGainControl allegato alla sessione di acquisizione.</string>
  <string name="set_fx_engine_a">Effetti con il motore A</string>
  <string name="set_fx_engine_a_desc">MediaRecorder non espone la propria sessione audio, quindi gli effetti seguono la preimpostazione della sorgente audio. Utilizza la modalità raw o passa all\'Engine B per un controllo esplicito.</string>
  <string name="set_silence">Salta il silenzio</string>
  <string name="set_silence_desc">Elimina l\'audio mentre il livello rimane sotto la soglia. Il motore B rilascia blocchi PCM; Il motore A mette in pausa/riprende MediaRecorder (API 24+).</string>
  <string name="set_silence_db">Soglia</string>
  <string name="set_silence_db_desc">Livello RMS (Engine B) o livello di picco (Engine A) al di sotto del quale l\'audio conta come silenzio.</string>
  <string name="set_silence_hold">Tieni il tempo</string>
  <string name="set_silence_hold_desc">Per quanto tempo il segnale deve rimanere silenzioso prima che inizi il salto. Il salto si interrompe immediatamente con l\'audio.</string>
  <string name="set_storage">Posizione</string>
  <string name="set_storage_desc">Entrambi sono su una memoria esterna. La cartella Musica pubblica necessita dell\'accesso allo spazio di archiviazione legacy (targetSdk 29 o autorizzazione di archiviazione); in caso contrario viene utilizzata la cartella dell\'app.</string>
  <string name="set_prefix">Prefisso del nome file</string>
  <string name="set_prefix_desc">I file sono denominati PREFIX_aaaaMMgg_HHmmss[.params].ext</string>
  <string name="set_folder">Cartella corrente</string>
  <string name="set_fft">Dimensione FFT dello spettro</string>
  <string name="set_fft_desc">Maggiore = risoluzione di frequenza più fine, risposta più lenta.</string>
  <string name="set_meter_speed">Aggiornamento del contatore</string>
  <string name="set_meter_speed_desc">La frequenza con cui il motore B invia i frame al dashboard.</string>
  <string name="set_keep_screen">Mantieni lo schermo acceso</string>
  <string name="set_keep_screen_desc">Durante la registrazione, sullo schermo del dashboard.</string>
