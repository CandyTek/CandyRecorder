  <string name="set_engine">Moteur d\'enregistrement</string>
  <string name="set_engine_desc">A emballe le flux via MediaRecorder. B lit le PCM brut d\'AudioRecord et donne un contrôle total sur la mise en page, les tampons, les effets et le codec.</string>
  <string name="set_source">Source audio</string>
  <string name="set_source_desc">Sélectionne le chemin d’entrée HAL et sa chaîne DSP par défaut. Les sources audio internes nécessitent l\'API 29 (capture de lecture) ou une version privilégiée (REMOTE_SUBMIX, appel vocal).</string>
  <string name="set_channels">Canaux</string>
  <string name="set_channels_desc">Capture mono ou stéréo. De nombreux téléphones délivrent un signal mono dupliqué sur les deux canaux.</string>
  <string name="set_sample_rate">Taux d\'échantillonnage</string>
  <string name="set_sample_rate_desc">Taux de capture demandé. AMR force 8/16 kHz. Les tarifs que HAL ne peut pas faire nativement sont rééchantillonnés par le framework.</string>
  <string name="set_route">Périphérique d\'entrée</string>
  <string name="set_route_desc">Entrée physique préférée. Bluetooth ouvre le lien SCO avec AudioManager.startBluetoothSco() avant la capture ; Les casques USB / Type-C sont sélectionnés via setPreferredDevice().</string>
  <string name="set_direction">Ramassage directionnel</string>
  <string name="set_direction_desc">API MicrophoneDirection (API 29+). Permet aux appareils multi-micros de diriger le faisceau vers ou loin de l\'utilisateur.</string>
  <string name="set_field">Dimension du champ de collecte</string>
  <string name="set_field_desc">Facteur de zoom de -1 (le plus large) à +1 (le plus étroit) pour les appareils prenant en charge la formation de faisceaux.</string>
  <string name="set_privacy">Sensible à la confidentialité</string>
  <string name="set_privacy_desc">Marque la capture comme sensible à la confidentialité (API 30+) : d\'autres applications et assistants ne peuvent pas capturer simultanément.</string>
  <string name="set_codec_b">Codec/conteneur de sortie</string>
  <string name="set_codec_b_desc">PCM va directement sur le disque. Les options compressées utilisent les encodeurs de la plateforme MediaCodec avec une entrée 16 bits.</string>
  <string name="set_pcm">Format d\'échantillon</string>
  <string name="set_pcm_desc">Disposition PCM fournie par AudioRecord. 24/32 bits nécessitent l\'API 31, float nécessite l\'API 23. Utilisé textuellement pour WAV / RAW.</string>
  <string name="set_bitrate">Débit</string>
  <string name="set_bitrate_desc">Débit binaire cible pour l\'encodeur MediaCodec.</string>
  <string name="set_bitrate_desc_a">Débit binaire cible pour MediaRecorder (les codecs AMR utilisent leurs débits fixes).</string>
  <string name="set_bitrate_mode">Mode débit</string>
  <string name="set_bitrate_mode_desc">KEY_BITRATE_MODE pour l\'encodeur. Tous les codecs ne prennent pas en charge tous les modes.</string>
  <string name="set_flac_level">Niveau de compression FLAC</string>
  <string name="set_flac_level_desc">0 = le plus rapide/le plus grand… 8 = le plus lent/le plus petit.</string>
  <string name="set_buffer">Tampon d\'enregistrement audio</string>
  <string name="set_buffer_desc">Multiplicateur appliqué à getMinBufferSize(). Plus petit = latence plus faible, plus grand = plus sûr contre les dépassements.</string>
  <string name="set_format_a">Récipient</string>
  <string name="set_format_a_desc">Format de sortie MediaRecorder. Le modifier sélectionne automatiquement un encodeur compatible.</string>
  <string name="set_encoder_a">Encodeur audio</string>
  <string name="set_encoder_a_desc">Seuls les encodeurs valides pour le conteneur choisi sont répertoriés.</string>
  <string name="set_raw">Mode audio brut/pur</string>
  <string name="set_raw_desc">Utilise la source NON PROCESSÉE lorsque l\'appareil la prend en charge et force la désactivation de NS/AEC/AGC, de sorte que le fichier conserve le signal du microphone intact.</string>
  <string name="set_ns">Suppresseur de bruit</string>
  <string name="set_ns_desc">Android.media.audiofx.NoiseSuppressor attaché à la session de capture.</string>
  <string name="set_aec">Annuleur d\'écho acoustique</string>
  <string name="set_aec_desc">Android.media.audiofx.AcousticEchoCanceler attaché à la session de capture.</string>
  <string name="set_agc">Contrôle automatique du gain</string>
  <string name="set_agc_desc">Android.media.audiofx.AutomaticGainControl attaché à la session de capture.</string>
  <string name="set_fx_engine_a">Effets avec le moteur A</string>
  <string name="set_fx_engine_a_desc">MediaRecorder n\'expose pas sa session audio, les effets suivent donc le préréglage de la source audio. Utilisez le mode brut ou passez au moteur B pour un contrôle explicite.</string>
  <string name="set_silence">Passer le silence</string>
  <string name="set_silence_desc">Supprime l\'audio pendant que le niveau reste sous le seuil. Le moteur B supprime les morceaux PCM ; Le moteur A met en pause/reprend MediaRecorder (API 24+).</string>
  <string name="set_silence_db">Seuil</string>
  <string name="set_silence_db_desc">Niveau RMS (moteur B) ou niveau de crête (moteur A) en dessous duquel l\'audio compte comme du silence.</string>
  <string name="set_silence_hold">Temps de maintien</string>
  <string name="set_silence_hold_desc">Combien de temps le signal doit rester silencieux avant que le saut ne commence. Le saut s\'arrête instantanément au son.</string>
  <string name="set_storage">Emplacement</string>
  <string name="set_storage_desc">Les deux sont sur un stockage externe. Le dossier Musique public nécessite un accès au stockage existant (targetSdk 29 ou autorisation de stockage) ; sinon, le dossier de l\'application est utilisé.</string>
  <string name="set_prefix">Préfixe du nom de fichier</string>
  <string name="set_prefix_desc">Les fichiers sont nommés PREFIX_aaaaMMjj_HHmmss[.params].ext</string>
  <string name="set_folder">Dossier actuel</string>
  <string name="set_fft">Taille FFT du spectre</string>
  <string name="set_fft_desc">Plus grand = résolution de fréquence plus fine, réponse plus lente.</string>
  <string name="set_meter_speed">Actualisation du compteur</string>
  <string name="set_meter_speed_desc">À quelle fréquence le moteur B pousse les cadres vers le tableau de bord.</string>
  <string name="set_keep_screen">Garder l\'écran allumé</string>
  <string name="set_keep_screen_desc">Pendant l\'enregistrement, sur l\'écran du tableau de bord.</string>
