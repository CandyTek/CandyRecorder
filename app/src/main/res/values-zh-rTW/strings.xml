  <string name="set_engine">錄音引擎</string>
  <string name="set_engine_desc">A透過MediaRecorder對流進行打包。 B 從 AudioRecord 讀取原始 PCM，並完全控制佈局、緩衝區、效果和編解碼器。</string>
  <string name="set_source">音源</string>
  <string name="set_source_desc">選擇 HAL 輸入路徑及其預設 DSP 鏈。內部音訊來源需要 API 29（回放擷取）或特權建構（REMOTE_SUBMIX、語音通話）。</string>
  <string name="set_channels">頻道</string>
  <string name="set_channels_desc">單聲道或立體聲捕捉。許多電話都會將單聲道訊號複製到兩個頻道。</string>
  <string name="set_sample_rate">取樣率</string>
  <string name="set_sample_rate_desc">請求的捕獲率。 AMR 強制為 8/16 kHz。 HAL 本身無法執行的速率由框架重新取樣。</string>
  <string name="set_route">輸入裝置</string>
  <string name="set_route_desc">首選物理輸入。藍牙在捕獲之前使用 AudioManager.startBluetoothSco() 開啟 SCO 連結； USB / Type-C 耳機透過 setPreferredDevice() 選擇。</string>
  <string name="set_direction">定向拾音器</string>
  <string name="set_direction_desc">麥克風方向 API（API 29+）。讓多麥克風裝置將波束轉向或遠離使用者。</string>
  <string name="set_field">拾取區域尺寸</string>
  <string name="set_field_desc">對於支援波束成形的設備，縮放係數從 -1（最寬）到 +1（最窄）。</string>
  <string name="set_privacy">隱私敏感</string>
  <string name="set_privacy_desc">將捕獲標記為隱私敏感（API 30+）：其他應用程式和助手無法同時捕獲。</string>
  <string name="set_codec_b">輸出編解碼器/容器</string>
  <string name="set_codec_b_desc">PCM 直接寫入磁碟。壓縮選項使用具有 16 位元輸入的平台 MediaCodec 編碼器。</string>
  <string name="set_pcm">樣本格式</string>
  <string name="set_pcm_desc">由 AudioRecord 提供的 PCM 佈局。 24/32 位元需要 API 31，浮點數需要 API 23。逐字用於 WAV / RAW。</string>
  <string name="set_bitrate">位元率</string>
  <string name="set_bitrate_desc">MediaCodec 編碼器的目標位元率。</string>
  <string name="set_bitrate_desc_a">MediaRecorder 的目標位元速率（AMR 編解碼器使用其固定速率）。</string>
  <string name="set_bitrate_mode">碼率模式</string>
  <string name="set_bitrate_mode_desc">編碼器的 KEY_BITRATE_MODE。並非每個編解碼器都支援每種模式。</string>
  <string name="set_flac_level">FLAC壓縮級別</string>
  <string name="set_flac_level_desc">0 = 最快/最大…8 = 最慢/最小。</string>
  <string name="set_buffer">錄音緩衝區</string>
  <string name="set_buffer_desc">應用於 getMinBufferSize() 的乘數。較小 = 較低的延遲，較大 = 更安全地防止溢出。</string>
  <string name="set_format_a">容器</string>
  <string name="set_format_a_desc">MediaRecorder 輸出格式。更改它會自動選擇相容的編碼器。</string>
  <string name="set_encoder_a">音訊編碼器</string>
  <string name="set_encoder_a_desc">僅列出對所選容器有效的編碼器。</string>
  <string name="set_raw">原始/純音訊模式</string>
  <string name="set_raw_desc">當裝置支援 UNPROCESSED 來源並強制關閉 NS / AEC / AGC 時，使用 UNPROCESSED 來源，因此檔案保留未觸及的麥克風訊號。</string>
  <string name="set_ns">噪音抑制器</string>
  <string name="set_ns_desc">Android.media.audiofx.NoiseSuppressor 附加到捕獲會話。</string>
  <string name="set_aec">聲學迴聲消除器</string>
  <string name="set_aec_desc">Android.media.audiofx.AcousticEchoCanceler 附加到捕獲會話。</string>
  <string name="set_agc">自動增益控制</string>
  <string name="set_agc_desc">Android.media.audiofx.AutomaticGainControl 附加到捕獲會話。</string>
  <string name="set_fx_engine_a">引擎 A 的效果</string>
  <string name="set_fx_engine_a_desc">MediaRecorder 不會公開其音訊會話，因此效果遵循音訊來源預設。使用原始模式或切換到引擎 B 進行明確控制。</string>
  <string name="set_silence">跳過沉默</string>
  <string name="set_silence_desc">當電平保持在閾值以下時丟棄音訊。引擎 B 丟棄 PCM 區塊；引擎 A 暫停/恢復 MediaRecorder (API 24+)。</string>
  <string name="set_silence_db">臨界點</string>
  <string name="set_silence_db_desc">RMS 電平（引擎 B）或峰值電平（引擎 A），低於該電平的音訊將被視為靜音。</string>
  <string name="set_silence_hold">保持時間</string>
  <string name="set_silence_hold_desc">在開始跳躍之前，訊號必須保持安靜多久。跳過聲音立即停止。</string>
  <string name="set_storage">地點</string>
  <string name="set_storage_desc">兩者都位於外部儲存空間上。公共 Music 資料夾需要舊儲存存取權限（targetSdk 29 或儲存權限）；否則使用應用程式資料夾。</string>
  <string name="set_prefix">檔名前綴</string>
  <string name="set_prefix_desc">檔案名稱為 PREFIX_yyyyMMdd_HHmmss[.params].ext</string>
  <string name="set_folder">目前資料夾</string>
  <string name="set_fft">頻譜 FFT 大小</string>
  <string name="set_fft_desc">越大=頻率解析度越高，反應越慢。</string>
  <string name="set_meter_speed">儀表重新整理</string>
  <string name="set_meter_speed_desc">引擎 B 將幀推送到儀表板的頻率。</string>
  <string name="set_keep_screen">保持螢幕開啟</string>
  <string name="set_keep_screen_desc">錄製時，在儀表板螢幕上。</string>
